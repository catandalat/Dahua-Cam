# Copy to .env and adjust for your deployment

DATABASE_URL=postgresql+asyncpg://anpr:anpr@postgres:5432/anpr
DATABASE_URL_SYNC=postgresql://anpr:anpr@postgres:5432/anpr
REDIS_URL=redis://redis:6379/0
SNAPSHOT_DIR=/data/snapshots
SESSION_OVERSTAY_HOURS=24
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
RETENTION_DAYS=30

# Web — prefer same-origin /api via Vite proxy (LAN-safe, no CORS)
# VITE_API_URL=/api
# VITE_WS_URL=
# VITE_PROXY_TARGET=http://api:8000
